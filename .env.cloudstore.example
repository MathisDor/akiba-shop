APP_NAME=AkibaShop
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://akibashop.ga

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Identifiants MySQL fournis dans cPanel > MySQL Databases.
# Sur la plupart des hébergements cPanel mutualisés (dont CloudStore Africa),
# DB_HOST reste "localhost" car MySQL tourne sur la même machine que le compte web.
# Vérifiez dans cPanel si un hôte distant différent vous a été communiqué.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_akibashop
DB_USERNAME=cpaneluser_akibashop
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.votre-domaine.tld
MAIL_PORT=587
MAIL_USERNAME=contact@votre-domaine.tld
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@votre-domaine.tld"
MAIL_FROM_NAME="${APP_NAME}"

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

VITE_APP_NAME="${APP_NAME}"
