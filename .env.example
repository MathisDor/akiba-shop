APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=akiba_shop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Comma-separated list of origins allowed to call the API from a browser
# (e.g. a separate web front-end). "*" is fine for local dev and for a
# mobile-only client. See config/cors.php.
CORS_ALLOWED_ORIGINS=*

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-Billing (Digitech Africa) — PAYIN mobile money (Airtel Money / Moov Money).
# LAB (sandbox) by default. Username/SharedKey come from your E-Billing merchant
# profile. Leave empty to keep using the simulated ManualPaymentGateway.
# Switching to production: change EBILLING_BASE_URL to the PROD API URL from
# Digitech Africa and use the PROD credentials they provide.
EBILLING_BASE_URL=https://lab.billing-easy.net/api/v1/merchant/
EBILLING_USERNAME=
EBILLING_SHARED_KEY=
EBILLING_EXPIRY_MINUTES=60

VITE_APP_NAME="${APP_NAME}"
